<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="ServiceDesk.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:ServiceDesk"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="ServiceDesk"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Janela" Background="{ThemeResource MarcaFundoBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            The Frame hosts pages for your application content. Add your UI to
            MainPage.xaml rather than here so you can use Page features such as
            navigation events and the Loaded lifecycle.
        -->
        <TextBlock Grid.Row="0" x:Name="MarcaCompacta" Margin="5,0,4,2" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextFillColorPrimaryBrush}" Visibility="Collapsed" />
        <Frame x:Name="RootFrame" Grid.Row="1" />
    </Grid>
</Window>
