<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="ServiceDesk.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded">
    <Page.Resources>
        <Style x:Key="FiltroStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="UseSystemFocusVisuals" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="FiltroRaiz" Background="{TemplateBinding Background}" BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver" />
                                    <VisualState x:Name="Pressed" />
                                    <VisualState x:Name="Checked" />
                                    <VisualState x:Name="CheckedPointerOver" />
                                    <VisualState x:Name="CheckedPressed" />
                                    <VisualState x:Name="Disabled"><VisualState.Setters><Setter Target="FiltroRaiz.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                                    <VisualState x:Name="CheckedDisabled"><VisualState.Setters><Setter Target="FiltroRaiz.Opacity" Value="0.4" /></VisualState.Setters></VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AtendimentoCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush"><Setter.Value><SolidColorBrush Color="Gray" Opacity="0.25" /></Setter.Value></Setter>
        </Style>
    </Page.Resources>
    <Grid Padding="20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock Text="ServiceDesk" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="SincronizacaoText" Text="Preparando sua fila…" TextWrapping="Wrap" Opacity="0.7" />
            </StackPanel>
            <CommandBar Grid.Column="1" DefaultLabelPosition="Collapsed" IsDynamicOverflowEnabled="True" Background="Transparent">
                <AppBarButton x:Name="MetricasButton" Icon="FourBars" Label="Métricas" ToolTipService.ToolTip="Métricas e SLA" Click="MetricasButton_Click" />
                <AppBarButton Icon="Setting" Label="Configurações" ToolTipService.ToolTip="Configurações" Click="ConfiguracoesButton_Click" />
                <AppBarButton x:Name="AtualizarButton" Icon="Refresh" Label="Atualizar" ToolTipService.ToolTip="Atualizar fila" Click="AtualizarButton_Click" />
            </CommandBar>
        </Grid>
        <StackPanel Grid.Row="1" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <ToggleButton Style="{StaticResource FiltroStyle}" x:Name="AbertosFiltro" Content="Em aberto (0)" Tag="Em aberto" Click="Filtro_Click" IsChecked="True" />
                <ToggleButton Style="{StaticResource FiltroStyle}" x:Name="AdiadosFiltro" Content="Adiados (0)" Tag="Adiado" Click="Filtro_Click" />
                <ToggleButton Style="{StaticResource FiltroStyle}" x:Name="TodosFiltro" Content="Todos (0)" Tag="Todos" Click="Filtro_Click" />
            </StackPanel>
        </StackPanel>
        <InfoBar x:Name="StatusInfo" Grid.Row="2" IsOpen="False" IsClosable="True" />
        <ScrollViewer x:Name="ListaScroll" Grid.Row="3" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" SizeChanged="Lista_SizeChanged">
            <Grid x:Name="AtendimentosList" HorizontalAlignment="Stretch" ColumnSpacing="12" RowSpacing="12" />
        </ScrollViewer>
        <InfoBar x:Name="AlertaInteracaoInfo" Grid.Row="4" IsOpen="False" IsClosable="True" Severity="Warning" Title="Tempo desde a última interação" />
    </Grid>
</Page>
